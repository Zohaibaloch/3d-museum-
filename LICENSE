<body>
    <div id="room-ui" class="ui-panel">
        <h2>🏛️ Virtual Museum</h2>
        <p style="margin-bottom: 15px; color: #aaa; font-size: 0.9rem;">No server needed! Direct P2P connection.</p>
        <input type="text" id="room-code" placeholder="Room Code (e.g., museum-1)" value="museum-1">
        <div class="btn-group">
            <button id="host-btn">Host Room</button>
            <button id="join-btn">Join Room</button>
        </div>
        <p id="status-msg" style="margin-top: 15px; color: #f1c40f; font-size: 0.9rem; min-height: 20px;"></p>
    </div>

    <div id="game-ui" style="display: none;">
        <div id="room-display">Room: <span id="current-room"></span></div>
        <div id="interaction-prompt" class="hidden"><span>Press [E] or Tap 'Sit' to watch</span></div>
        <div id="controls-menu">
            <div class="menu-section">
                <button class="emote-btn" data-emote="heart">❤️</button>
                <button class="emote-btn" data-emote="dance">💃</button>
                <button class="emote-btn" data-emote="kiss">😘</button>
                <button class="emote-btn" data-emote="wave">👋</button>
            </div>
            <div class="menu-section">
                <button class="emoji-btn" data-emoji="😂">😂</button>
                <button class="emoji-btn" data-emoji="😍">😍</button>
                <button class="emoji-btn" data-emoji="🔥">🔥</button>
                <button class="emoji-btn" data-emoji="👏">👏</button>
            </div>
        </div>
        <div id="mobile-controls">
            <div id="joystick-zone"><div id="joystick-knob"></div></div>
            <button id="sit-stand-btn">Sit / Stand</button>
        </div>
    </div>
    <div id="emoji-container"></div>

    <script>
        let peer = null, conn = null, isHost = false;
        let myPlayerId = null, remotePlayerId = null;
        let isGameInitialized = false;
        const statusMsg = document.getElementById('status-msg');

        // --- P2P CONNECTION LOGIC ---
        document.getElementById('host-btn').addEventListener('click', () => {
            const roomId = document.getElementById('room-code').value.trim();
            if (!roomId) return alert("Please enter a room code");
            statusMsg.textContent = "Creating room...";
            isHost = true;
            myPlayerId = 'host-' + roomId;
            
            peer = new Peer(myPlayerId, { debug: 1 });
            peer.on('open', () => {
                statusMsg.textContent = "Room created! Waiting for player...";
                startGame();
            });
            peer.on('connection', (c) => {
                if (conn) { // Max 2 players
                    c.on('open', () => { c.send({ type: 'roomFull' }); setTimeout(() => c.close(), 100); });
                    return;
                }
                conn = c;
                setupConnection();
            });
            peer.on('error', (err) => {
                if (err.type === 'unavailable-id') statusMsg.textContent = "Room already exists. Try joining or use a different code.";
                else statusMsg.textContent = "Error: " + err.type;
            });
        });

        document.getElementById('join-btn').addEventListener('click', () => {
            const roomId = document.getElementById('room-code').value.trim();
            if (!roomId) return alert("Please enter a room code");
            statusMsg.textContent = "Connecting to room...";
            isHost = false;
            
            peer = new Peer({ debug: 1 });
            peer.on('open', (id) => {
                myPlayerId = id;
                conn = peer.connect(roomId, { reliable: true });
                setupConnection();
            });
            peer.on('error', (err) => {
                if (err.type === 'peer-unavailable') statusMsg.textContent = "Room not found. Check code or ask host to stay online.";
                else statusMsg.textContent = "Error: " + err.type;
            });
        });

        function setupConnection() {
            conn.on('open', () => {
                if (isHost) {
                    conn.send({ type: 'initPlayers', players: [{ id: myPlayerId, x: 0, y: 0, z: 5, rotation: 0, animation: 'idle', isSitting: false }] });
                } else {
                    conn.send({ type: 'playerJoined', player: { id: myPlayerId, x: 0, y: 0, z: 5, rotation: 0, animation: 'idle', isSitting: false } });
                }
                startGame();
            });
            conn.on('data', handleData);
            conn.on('close', () => {
                if (isHost && remotePlayerId) {
                    removePlayer(remotePlayerId);
                    remotePlayerId = null;
                    alert("Player disconnected. Waiting for a new player...");
                } else if (!isHost) {
                    alert("Host disconnected!");
                    location.reload();
                }
            });
        }

        function handleData(data) {
            switch(data.type) {
                case 'roomFull': alert("Room is full (Max 2 players)."); location.reload(); break;
                case 'initPlayers':
                    data.players.forEach(p => {
                        if (p.id !== myPlayerId) { createPlayer(p.id, p.x, p.y, p.z, false); remotePlayerId = p.id; }
                    });
                    break;
                case 'playerJoined':
                    remotePlayerId = data.player.id;
                    createPlayer(data.player.id, data.player.x, data.player.y, data.player.z, false);
                    break;
                case 'playerUpdate': updatePlayer(data.player); break;
                case 'triggerEmote': playRemoteEmote(data.playerId, data.emote); break;
                case 'triggerEmoji': showFloatingEmoji(data.playerId, data.emoji); break;
            }
        }

        function send(data) { if (conn && conn.open) conn.send(data); }

        // --- GAME LOGIC ---
        const players = new Map();
        const keys = { w: false, a: false, s: false, d: false };
        let isSitting = false, canInteract = false;
        let scene, camera, renderer, clock, localPlayerMesh, raycaster;
        let interactableBenches = [];

        function startGame() {
            if (isGameInitialized) return;
            isGameInitialized = true;
            document.getElementById('room-ui').style.display = 'none';
            document.getElementById('game-ui').style.display = 'block';
            document.getElementById('current-room').textContent = document.getElementById('room-code').value.trim();
            if ('ontouchstart' in window || navigator.maxTouchPoints > 0) {
                document.getElementById('mobile-controls').style.display = 'flex';
            }
            initThreeJS();
            createPlayer(myPlayerId, 0, 0, 5, true);
        }

        function initThreeJS() {
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0xf0f0f0);
            scene.fog = new THREE.Fog(0xf0f0f0, 10, 40);
            camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 100);
            camera.position.set(0, 3, 8);
            renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            renderer.shadowMap.enabled = true;
            renderer.shadowMap.type = THREE.PCFSoftShadowMap;
            document.body.appendChild(renderer.domElement);
            clock = new THREE.Clock();
            raycaster = new THREE.Raycaster();
            setupLighting();
            buildMuseum();
            setupInputs();
            animate();
        }

        function setupLighting() {
            scene.add(new THREE.AmbientLight(0xffffff, 0.6));
            const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
            dirLight.position.set(5, 10, 5);
            dirLight.castShadow = true;
            dirLight.shadow.mapSize.width = 2048;
            dirLight.shadow.mapSize.height = 2048;
            scene.add(dirLight);
        }

        function buildMuseum() {
            const floor = new THREE.Mesh(new THREE.PlaneGeometry(20, 30), new THREE.MeshStandardMaterial({ color: 0xe0e0e0, roughness: 0.1 }));
            floor.rotation.x = -Math.PI / 2; floor.receiveShadow = true; scene.add(floor);

            const backWall = new THREE.Mesh(new THREE.BoxGeometry(20, 6, 0.5), new THREE.MeshStandardMaterial({ color: 0xffffff }));
            backWall.position.set(0, 3, -10); backWall.receiveShadow = true; scene.add(backWall);

            [{ x: -6, z: -9.7 }, { x: 0, z: -9.7 }, { x: 6, z: -9.7 }].forEach(pos => {
                const frame = new THREE.Mesh(new THREE.BoxGeometry(3, 2, 0.2), new THREE.MeshStandardMaterial({ color: 0x111111 }));
                frame.position.set(pos.x, 3, pos.z); scene.add(frame);
                const canvas = document.createElement('canvas'); canvas.width = 256; canvas.height = 256;
                const ctx = canvas.getContext('2d'); ctx.fillStyle = '#2c3e50'; ctx.fillRect(0,0,256,256);
                ctx.fillStyle = '#ecf0f1'; ctx.font = 'bold 24px Arial'; ctx.textAlign = 'center';
                ctx.fillText('Digital Art', 128, 138);
                const art = new THREE.Mesh(new THREE.PlaneGeometry(2.8, 1.8), new THREE.MeshBasicMaterial({ map: new THREE.CanvasTexture(canvas) }));
                art.position.set(pos.x, 3, pos.z - 0.16); scene.add(art);
            });

            const video = document.createElement('video');
            video.src = 'https://files.catbox.moe/vxrz4l.mp4';
            video.crossOrigin = 'anonymous'; video.loop = true; video.muted = true; video.playsInline = true;
            video.play().catch(() => {
                const playVid = () => { video.play(); document.body.removeEventListener('click', playVid); document.body.removeEventListener('touchstart', playVid); };
                document.body.addEventListener('click', playVid, { once: true });
                document.body.addEventListener('touchstart', playVid, { once: true });
            });
            const screenMesh = new THREE.Mesh(new THREE.PlaneGeometry(8, 4.5), new THREE.MeshBasicMaterial({ map: new THREE.VideoTexture(video) }));
            screenMesh.position.set(0, 3.5, -9.6); scene.add(screenMesh);

            const bench = new THREE.Mesh(new THREE.BoxGeometry(4, 0.5, 1), new THREE.MeshStandardMaterial({ color: 0x5D4037 }));
            bench.position.set(0, 0.25, -4); bench.castShadow = true; bench.receiveShadow = true;
            scene.add(bench); interactableBenches.push(bench);
        }

        function createPlayer(id, x, y, z, isLocal) {
            const group = new THREE.Group(); group.position.set(x, y, z);
            const body = new THREE.Mesh(new THREE.CapsuleGeometry(0.4, 1, 4, 8), new THREE.MeshStandardMaterial({ color: isLocal ? 0x4a90e2 : 0xe74c3c }));
            body.position.y = 0.9; body.castShadow = true; group.add(body);
            const head = new THREE.Mesh(new THREE.SphereGeometry(0.3, 16, 16), new THREE.MeshStandardMaterial({ color: 0xffccaa }));
            head.position.y = 1.7; head.castShadow = true; group.add(head);
            scene.add(group);
            players.set(id, { mesh: group, isLocal, targetPos: new THREE.Vector3(x, y, z), emote: null, emojiElement: null });
            if (isLocal) localPlayerMesh = group;
        }

        function updatePlayer(data) {
            const p = players.get(data.id);
            if (p) {
                p.targetPos.set(data.x, data.y, data.z);
                p.mesh.rotation.y = data.rotation;
                if (data.isSitting) p.mesh.position.copy(p.targetPos);
            }
        }

        function removePlayer(id) {
            const p = players.get(id);
            if (p) { scene.remove(p.mesh); if (p.emojiElement) p.emojiElement.remove(); players.delete(id); }
        }

        function setupInputs() {
            window.addEventListener('keydown', (e) => {
                const key = e.key.toLowerCase();
                if (keys.hasOwnProperty(key)) keys[key] = true;
                if (key === 'e' && canInteract) toggleSit();
            });
            window.addEventListener('keyup', (e) => {
                const key = e.key.toLowerCase();
                if (keys.hasOwnProperty(key)) keys[key] = false;
            });

            document.querySelectorAll('.emote-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    send({ type: 'triggerEmote', playerId: myPlayerId, emote: btn.dataset.emote });
                    playLocalEmote(btn.dataset.emote);
                });
            });
            document.querySelectorAll('.emoji-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    send({ type: 'triggerEmoji', playerId: myPlayerId, emoji: btn.dataset.emoji });
                    showFloatingEmoji(myPlayerId, btn.dataset.emoji);
                });
            });
            document.getElementById('sit-stand-btn').addEventListener('click', () => { if (canInteract) toggleSit(); });

            const joystickZone = document.getElementById('joystick-zone');
            const joystickKnob = document.getElementById('joystick-knob');
            let touchStartX = 0, touchStartY = 0, isTouching = false;

            joystickZone.addEventListener('touchstart', (e) => {
                isTouching = true; const touch = e.touches[0];
                touchStartX = touch.clientX; touchStartY = touch.clientY;
                joystickKnob.style.transition = 'none';
            }, { passive: false });

            joystickZone.addEventListener('touchmove', (e) => {
                if (!isTouching) return; e.preventDefault();
                const touch = e.touches[0];
                const deltaX = touch.clientX - touchStartX, deltaY = touch.clientY - touchStartY;
                const distance = Math.min(Math.sqrt(deltaX**2 + deltaY**2), 35);
                const angle = Math.atan2(deltaY, deltaX);
                joystickKnob.style.transform = `translate(calc(-50% + ${Math.cos(angle) * distance}px), calc(-50% + ${Math.sin(angle) * distance}px))`;
                keys.w = deltaY < -15; keys.s = deltaY > 15; keys.a = deltaX < -15; keys.d = deltaX > 15;
            }, { passive: false });

            const endTouch = () => {
                isTouching = false; keys.w = keys.a = keys.s = keys.d = false;
                joystickKnob.style.transition = 'transform 0.2s';
                joystickKnob.style.transform = 'translate(-50%, -50%)';
            };
            joystickZone.addEventListener('touchend', endTouch);
            joystickZone.addEventListener('touchcancel', endTouch);

            window.addEventListener('resize', () => {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            });
        }

        function toggleSit() {
            isSitting = !isSitting;
            const p = players.get(myPlayerId);
            if (isSitting) {
                p.mesh.position.set(0, 0.5, -3.5); p.mesh.rotation.y = Math.PI;
                send({ type: 'playerUpdate', player: { id: myPlayerId, x: 0, y: 0.5, z: -3.5, rotation: Math.PI, isSitting: true, animation: 'sitting' } });
            } else {
                p.mesh.position.set(0, 0, -2.5); p.mesh.rotation.y = 0;
                send({ type: 'playerUpdate', player: { id: myPlayerId, x: 0, y: 0, z: -2.5, rotation: 0, isSitting: false, animation: 'idle' } });
            }
        }

        function playLocalEmote(emote) {
            const p = players.get(myPlayerId);
            if (emote === 'heart') { p.mesh.scale.set(1.2, 1.2, 1.2); setTimeout(() => p.mesh.scale.set(1, 1, 1), 1000); }
            else if (emote === 'dance') {
                let spins = 0; const interval = setInterval(() => { p.mesh.rotation.y += 0.4; spins++; if (spins > 15) clearInterval(interval); }, 50);
            } else if (emote === 'kiss') {
                showFloatingEmoji(myPlayerId, '😘'); p.mesh.position.y += 0.2; setTimeout(() => p.mesh.position.y -= 0.2, 300);
            } else if (emote === 'wave') {
                let waves = 0; const interval = setInterval(() => { p.mesh.rotation.z = waves % 2 === 0 ? 0.2 : -0.2; waves++; if (waves > 5) { p.mesh.rotation.z = 0; clearInterval(interval); } }, 150);
            }
        }

        function playRemoteEmote(playerId, emote) {
            const p = players.get(playerId); if (!p) return;
            p.emote = emote;
            if (emote === 'heart') showFloatingHeart(playerId);
            else if (emote === 'dance') {
                let spins = 0; const interval = setInterval(() => {
                    if (!players.has(playerId)) return clearInterval(interval);
                    p.mesh.rotation.y += 0.4; spins++; if (spins > 15) clearInterval(interval);
                }, 50);
            } else if (emote === 'kiss') {
                showFloatingEmoji(playerId, '😘'); p.mesh.position.y += 0.2; setTimeout(() => { if(players.has(playerId)) p.mesh.position.y -= 0.2; }, 300);
            } else if (emote === 'wave') {
                let waves = 0; const interval = setInterval(() => {
                    if (!players.has(playerId)) return clearInterval(interval);
                    p.mesh.rotation.z = waves % 2 === 0 ? 0.2 : -0.2; waves++; if (waves > 5) { p.mesh.rotation.z = 0; clearInterval(interval); }
                }, 150);
            }
            setTimeout(() => {
                if (players.has(playerId)) {
                    players.get(playerId).emote = null; p.mesh.scale.set(1, 1, 1);
                    if (p.emojiElement && p.emojiElement.classList.contains('floating-heart')) { p.emojiElement.remove(); p.emojiElement = null; }
                }
            }, 3000);
        }

        function showFloatingEmoji(playerId, emoji) {
            const p = players.get(playerId); if (!p) return;
            if (p.emojiElement) p.emojiElement.remove();
            const el = document.createElement('div'); el.className = 'floating-emoji'; el.textContent = emoji;
            document.getElementById('emoji-container').appendChild(el); p.emojiElement = el;
            setTimeout(() => { if (p.emojiElement === el) { el.remove(); p.emojiElement = null; } }, 2500);
        }

        function showFloatingHeart(playerId) {
            const p = players.get(playerId); if (!p) return;
            if (p.emojiElement) p.emojiElement.remove();
            const el = document.createElement('div'); el.className = 'floating-heart'; el.textContent = '❤️';
            document.getElementById('emoji-container').appendChild(el); p.emojiElement = el;
        }

        let lastUpdate = 0;
        function animate() {
            requestAnimationFrame(animate);
            const delta = Math.min(clock.getDelta(), 0.1);
            if (localPlayerMesh && !isSitting) {
                const speed = 5 * delta; let moved = false; const pos = localPlayerMesh.position;
                if (keys.w) { pos.z -= speed; moved = true; }
                if (keys.s) { pos.z += speed; moved = true; }
                if (keys.a) { pos.x -= speed; moved = true; localPlayerMesh.rotation.y = Math.PI / 2; }
                if (keys.d) { pos.x += speed; moved = true; localPlayerMesh.rotation.y = -Math.PI / 2; }
                
                if (moved) {
                    camera.position.x += (pos.x - camera.position.x) * 0.1;
                    camera.position.z += (pos.z + 8 - camera.position.z) * 0.1;
                    camera.lookAt(pos.x, 1, pos.z);
                    const now = Date.now();
                    if (now - lastUpdate > 50) { // Throttle to 20 updates/sec for optimization
                        send({ type: 'playerUpdate', player: { id: myPlayerId, x: pos.x, y: pos.y, z: pos.z, rotation: localPlayerMesh.rotation.y, animation: 'walking', isSitting: false } });
                        lastUpdate = now;
                    }
                }
            }
            players.forEach((p) => {
                if (!p.isLocal && !p.emote) p.mesh.position.lerp(p.targetPos, 0.15);
                if (p.emojiElement) {
                    const vector = new THREE.Vector3(0, 2.5, 0);
                    vector.applyMatrix4(p.mesh.matrixWorld); vector.project(camera);
                    if (vector.z < 1) {
                        p.emojiElement.style.left = `${(vector.x * 0.5 + 0.5) * window.innerWidth}px`;
                        p.emojiElement.style.top = `${(-(vector.y * 0.5) + 0.5) * window.innerHeight}px`;
                        p.emojiElement.style.display = 'block';
                    } else { p.emojiElement.style.display = 'none'; }
                }
            });
            if (!isSitting) {
                raycaster.setFromCamera(new THREE.Vector2(0, 0), camera);
                const intersects = raycaster.intersectObjects(interactableBenches);
                if (intersects.length > 0 && intersects[0].distance < 4) {
                    canInteract = true; document.getElementById('interaction-prompt').classList.remove('hidden');
                } else {
                    canInteract = false; document.getElementById('interaction-prompt').classList.add('hidden');
                }
            }
            renderer.render(scene, camera);
        }
    </script>
</body>
</html>

